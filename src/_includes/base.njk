<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#102d36">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.title }}"><meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/crew-12.webp"><meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
  <link rel="icon" href="/assets/hat.svg" type="image/svg+xml">
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/site.css"><script src="/assets/site.js" defer></script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">跳到正文</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="张峰瑜的伟大航线首页"><img src="/assets/hat.svg" alt="" width="42" height="36"><span>张峰瑜的伟大航线</span></a>
    <nav aria-label="主导航"><a href="/journal/" {% if nav == 'journal' %}aria-current="page"{% endif %}>航海日志</a><a href="/works/" {% if nav == 'works' %}aria-current="page"{% endif %}>作品展示</a><a href="/about/" {% if nav == 'about' %}aria-current="page"{% endif %}>关于我</a></nav>
    <div class="header-tools"><a class="search-link" href="/search/" aria-label="搜索文章"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>搜索</span></a><button class="theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.8 14.5A9 9 0 0 1 9.5 3.2 9 9 0 1 0 20.8 14.5Z"/></svg></button></div>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="site-footer"><div class="footer-top"><a href="/">{{ site.title }}</a><a href="/journal/">去读一篇日志 →</a></div><p class="footer-title">下一站，继续探索。</p><div class="footer-bottom"><span>© 2026 张峰瑜</span><span>个人博客 · 海贼王主题</span><a href="/credits/">图片说明</a><a href="https://github.com/{{ site.repo }}">GitHub</a></div></footer>
</body>
</html>
